# ExamSense Environment Variables
# =================================
# Copy this file to .env and fill in your API keys.

# Groq API Key (primary LLM) — get free key at https://console.groq.com/keys
EXAMSENSE_GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (fallback LLM) — get free key at https://aistudio.google.com/
EXAMSENSE_GEMINI_API_KEY=your_gemini_api_key_here
