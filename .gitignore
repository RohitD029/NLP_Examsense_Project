# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.ruff_cache/
.pytest_cache/

# Virtual Environments
.venv/
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

